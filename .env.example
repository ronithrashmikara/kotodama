REACTOR_API_KEY=replace_with_your_reactor_api_key
CEREBRAS_API_KEY=replace_with_your_cerebras_api_key
GROQ_API_KEY=replace_with_your_groq_api_key
# Optional: a second Groq key, a second daily allowance.
GROQ_API_KEY_2=
FISH_API_KEY=replace_with_your_fish_audio_api_key
FAL_KEY=replace_with_your_fal_api_key

# Live dreaming allowance (lib/server/quota.ts). On in production only.
# Each dream is one Orbis session of up to 5 minutes (about $2.91).
YUME_VISITOR_MINUTES=30
YUME_JUDGE_MINUTES=60
YUME_DAILY_BUDGET_USD=20
# Comma-separated; a judge opens the site with ?judge=CODE.
YUME_JUDGE_CODES=
# Optional; defaults to a secret derived from REACTOR_API_KEY.
YUME_QUOTA_SECRET=
